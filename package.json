{
  "name": "fluid-player",
  "version": "0.1.0",
  "private": true,
  "description": "Digital signage player and local media orchestration runtime",
  "type": "module",
  "workspaces": [
    "target/webos",
    "target/tizen",
    "target/android",
    "target/pc",
    "element/litelement/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:device": "vitest run src/module/device/test",
    "test:device:coverage": "vitest run --coverage src/module/device/test",
    "clean": "rm -rf dist coverage target/webos/dist target/webos/pkg target/tizen/dist target/tizen/pkg target/android/dist target/android/native/.gradle target/android/native/build target/android/native/app/build target/pc/dist target/pc/dist-electron",
    "dev:webos": "npm run dev -w @fluid-player/webos",
    "build:webos": "npm run build -w @fluid-player/webos",
    "preview:webos": "npm run preview -w @fluid-player/webos",
    "typecheck:webos": "npm run typecheck -w @fluid-player/webos",
    "package:webos": "npm run build:webos && ares-package target/webos/dist -o target/webos/pkg",
    "simulate:webos": "npm run build:webos && dotenv -- sh -c 'ares-launch -s \"$WEBOS_SIMULATOR_VERSION\" -sp \"$WEBOS_SIMULATOR_PATH\" target/webos/dist'",
    "dev:tizen": "npm run dev -w @fluid-player/tizen",
    "build:tizen": "npm run build -w @fluid-player/tizen",
    "preview:tizen": "npm run preview -w @fluid-player/tizen",
    "typecheck:tizen": "npm run typecheck -w @fluid-player/tizen",
    "package:tizen": "npm run package -w @fluid-player/tizen",
    "simulate:tizen": "npm run build:tizen && dotenv -- node target/tizen/scripts/simulate.mjs",
    "dev:android": "npm run dev -w @fluid-player/android",
    "build:android": "npm run build -w @fluid-player/android",
    "preview:android": "npm run preview -w @fluid-player/android",
    "typecheck:android": "npm run typecheck -w @fluid-player/android",
    "package:android": "npm run build:android && node target/android/scripts/sync-assets.mjs",
    "simulate:android": "npm run package:android && node target/android/scripts/simulate.mjs",
    "dev:pc": "npm run dev -w @fluid-player/pc",
    "build:pc": "npm run build -w @fluid-player/pc",
    "start:pc": "npm run build:pc && npm run start -w @fluid-player/pc",
    "preview:pc": "npm run preview -w @fluid-player/pc",
    "typecheck:pc": "npm run typecheck -w @fluid-player/pc",
    "demo:app-header": "npm run demo -w @fluid-element/app-header",
    "demo:app-navigation-drawer": "npm run demo -w @fluid-element/app-navigation-drawer",
    "demo:lit-grid": "npm run demo -w @fluid-element/lit-grid",
    "demo:lit-pagination": "npm run demo -w @fluid-element/lit-pagination",
    "demo:lit-tooltip": "npm run demo -w @fluid-element/lit-tooltip",
    "demo:mockup": "vite --config docs/mockup/vite.config.ts",
    "build:mockup": "vite build --config docs/mockup/vite.config.ts",
    "preview:mockup": "vite preview --config docs/mockup/vite.config.ts",
    "test:elements": "npm run test -w @fluid-element/app-header && npm run test -w @fluid-element/app-navigation-drawer && npm run test -w @fluid-element/lit-grid && npm run test -w @fluid-element/lit-pagination && npm run test -w @fluid-element/lit-tooltip"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/web": "^2.5.0",
    "@mdi/font": "^7.4.47",
    "@vitest/coverage-v8": "^3.2.7",
    "@webos-tools/cli": "^3.2.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-jsdoc": "^54.1.1",
    "lit": "^3.3.1",
    "material-symbols": "^0.31.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.2",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.4"
  }
}
