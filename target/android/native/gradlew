#!/bin/sh
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
WRAPPER="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER" ]; then
  echo "Missing $WRAPPER" >&2
  exit 1
fi

JAVA_CMD=${JAVA_HOME:+$JAVA_HOME/bin/java}
JAVA_CMD=${JAVA_CMD:-java}

exec "$JAVA_CMD" -classpath "$WRAPPER" org.gradle.wrapper.GradleWrapperMain "$@"
