<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
  id="http://fluid.player/tizen" version="0.1.0" viewmodes="maximized">
  <tizen:application id="FluidPlayr.FluidPlayer" package="FluidPlayr" required_version="6.0" />
  <content src="index.html" />
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920" />
  <icon src="icon.png" />
  <name>Fluid Player</name>
  <description>Digital signage player for Tizen TV</description>
  <tizen:profile name="tv-samsung" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:setting
    screen-orientation="landscape"
    context-menu="enable"
    background-support="disable"
    encryption="disable"
    install-location="auto"
    hwkey-event="enable" />
</widget>
