# Versione del webOS TV Simulator installato in locale (es. 23, 24, 25, 26)
WEBOS_SIMULATOR_VERSION=26

# Cartella del Simulator (quella con l'AppImage), non il path dell'AppImage
WEBOS_SIMULATOR_PATH=/absolute/path/to/webOS_TV_26_Simulator_1.5.0

# Tizen Studio root (contiene tools/sec-tv-simulator/simulator.sh)
TIZEN_STUDIO_PATH=/absolute/path/to/tizen-studio
